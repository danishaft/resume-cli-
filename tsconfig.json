{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "dist",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"sourceMap": true,
		"declarationMap": true,
		"skipLibCheck": true
	},
	"include": ["continues.ts", "src/**/*.ts"]
}
